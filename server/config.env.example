# Stashr API server environment.
# Copy this file to config.env in this directory. Never commit config.env.
# Use real secrets only in your local environment or hosting provider's secret store.

# Required: MongoDB connection string (local or MongoDB Atlas).
MONGO_URL=mongodb://127.0.0.1:27017/stashr

# Required: random, unique secrets. Generate independently with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep SECRET_KEY and CRYPTO_SECRET_KEY separate and stable for a deployment.
SECRET_KEY=replace-with-a-random-secret
CRYPTO_SECRET_KEY=replace-with-a-different-random-secret

# Optional database aliases accepted by server/db/connection.js:
# DATABASE=
# MONGODB_URI=

# Runtime / networking.
NODE_ENV=development
PORT=8000
# Comma-separated browser/extension origins allowed by CORS.
# CLIENT_ORIGINS=http://localhost:3000,https://your-web.example
# Comma-separated Chrome extension origins (exact extension IDs).
# EXTENSION_ORIGINS=chrome-extension://replace-with-extension-id
# Public URL of this server for health pinging/worker callbacks.
# SELF_URL=https://your-api.example
# KEEP_ALIVE=false
# KEEP_ALIVE_MINUTES=14

# Google OAuth for the TV's movies (Smart home -> Movies from Google Drive). Register the exact redirect URI in Google Cloud Console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_PHOTO_REDIRECT_URI=https://your-api.example/photo-cloud/google/callback
# PHOTO_CLOUD_CLIENT_URL=https://your-web.example
# GOOGLE_PHOTO_SCOPES=openid email https://www.googleapis.com/auth/drive.readonly

# Monitoring scheduler. Configure the same value on the trusted scheduler's
# Authorization: Bearer header for POST /render/ops/tick.
# RENDER_MONITOR_CRON_SECRET=replace-with-a-long-random-secret

# Transactional email / password reset codes (Brevo).
# Only set a real API key in your local config.env or hosting secrets.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Stashr

# Optional Groq-powered diagnostics (feature/consent dependent).
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b


# Optional values consumed by integrations / worker processes.
# HASH_KEY=legacy-alias-for-CRYPTO_SECRET_KEY
# Add integration-specific secrets only when you have verified which feature
# consumes them; never use real credentials as sample values.

# ShineOne Estate website photos (Media page). Same Cloudinary account the Tasks app uses.
CLOUDINARY_CLOUD_NAME_shine=
CLOUDINARY_API_KEY_shine=
CLOUDINARY_API_SECRET_shine=

# Optional: YouTube Data API v3 key. With it, "tv par arijit songs" on Smart home plays the first matching video on the
# TV; without it the TV opens the YouTube search page for those words.
YOUTUBE_API_KEY=

# Smart home arrival time. Optional: a PUBLIC Mapbox token (pk.…) turns on live traffic ("Papa is 18 min away right now").
# Without it the time comes from the free OSRM server (normal driving time, no traffic). OSRM_URL points at your own OSRM.
# HOME_ROUTING=off sends nothing to any routing service (straight-line estimate only).
# MAPBOX_TOKEN=
# OSRM_URL=


# Firebase push (optional): lets the server wake a family phone whose location has gone quiet. Paste the whole service-account JSON
# (Firebase console > Project settings > Service accounts > Generate new private key) as one value, or its base64. FIREBASE_SERVICE_ACCOUNT works too.
# STASHR_FIREBASE_KEY=

# Search assistant (launcher search bar and the Stashr search screen). Set any of these; the first one set answers unless the app picks one.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Google web results (Programmable Search Engine: https://programmablesearchengine.google.com/):
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_CX=

# Moving to a new (e.g. free 512 MB) MongoDB without losing the old data:
# keep MONGO_URL as the OLD database and add the new one below. Every write goes to the new database; the old one is only read, and
# its data is copied over by itself as it is used and in the background. Remove MONGO_URL_NEW's partner (the old one) when
# GET /system/db (admin) shows every collection as drained.
# MONGO_URL_NEW=mongodb+srv://user:pass@new-cluster.mongodb.net/stashr
# NEW_DB_CAP_MB=460          # stop copying at this size (free tier is 512)
# MIGRATE_AUTO=true          # start the background copy 30 s after boot
# MIGRATE_SKIP=              # collections to leave in the old database, comma separated

# The removed Photos feature left its data in MongoDB (photoMedia etc. on accounts, import and shared-folder collections).
# It is NOT deleted automatically. Set this to true for one boot to permanently delete it and free space, then unset it.
# PHOTO_DATA_CLEANUP=true
