<?xml version="1.0" encoding="utf-8"?>
<!-- "Stashr Home" in the website's departure-board style: dark tiles, amber monospace labels, cream values, a green status dot. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/stashr_widget_bg"
  android:paddingStart="14dp"
  android:paddingEnd="14dp"
  android:paddingTop="12dp"
  android:paddingBottom="10dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <ImageView
      android:id="@+id/widget_dot"
      android:layout_width="8dp"
      android:layout_height="8dp"
      android:layout_marginEnd="8dp"
      android:src="@drawable/stashr_widget_dot"
      android:importantForAccessibility="no" />
    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/stashr_home_widget_title"
      android:textColor="#F5C86A"
      android:textSize="12sp"
      android:fontFamily="monospace"
      android:letterSpacing="0.2"
      android:textStyle="bold"
      android:maxLines="1" />
    <TextView
      android:id="@+id/widget_updated"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/stashr_widget_tile"
      android:paddingStart="6dp"
      android:paddingEnd="6dp"
      android:paddingTop="1dp"
      android:paddingBottom="1dp"
      android:textColor="#F2F0E6"
      android:textSize="12sp"
      android:fontFamily="monospace"
      android:letterSpacing="0.1"
      android:maxLines="1" />
  </LinearLayout>

  <ImageView
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:importantForAccessibility="no"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    android:background="#1A262D" />

  <LinearLayout android:id="@+id/row_coming" style="@style/StashrBoardRow" android:visibility="gone">
    <TextView style="@style/StashrBoardLabel" android:text="ETA" android:textColor="#3CCF9A" />
    <TextView android:id="@+id/widget_coming" style="@style/StashrBoardValue" android:textColor="#6EE7B0" />
  </LinearLayout>

  <LinearLayout android:id="@+id/row_people" style="@style/StashrBoardRow">
    <TextView style="@style/StashrBoardLabel" android:text="HOME" />
    <TextView android:id="@+id/widget_people" style="@style/StashrBoardValue" android:text="Open Stashr to load your home" />
  </LinearLayout>

  <LinearLayout android:id="@+id/row_weather" style="@style/StashrBoardRow" android:visibility="gone">
    <TextView style="@style/StashrBoardLabel" android:text="WX" />
    <TextView android:id="@+id/widget_weather" style="@style/StashrBoardValue" />
  </LinearLayout>

  <LinearLayout android:id="@+id/row_tv" style="@style/StashrBoardRow" android:visibility="gone">
    <TextView style="@style/StashrBoardLabel" android:text="TV" />
    <TextView android:id="@+id/widget_tv" style="@style/StashrBoardValue" />
  </LinearLayout>
</LinearLayout>
