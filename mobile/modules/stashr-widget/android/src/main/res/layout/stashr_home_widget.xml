<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/stashr_widget_bg"
  android:paddingStart="16dp"
  android:paddingEnd="16dp"
  android:paddingTop="12dp"
  android:paddingBottom="12dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <ImageView
      android:layout_width="8dp"
      android:layout_height="8dp"
      android:layout_marginEnd="8dp"
      android:src="@drawable/stashr_widget_dot"
      android:importantForAccessibility="no" />
    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/stashr_home_widget_label"
      android:textColor="#F8FAFC"
      android:textSize="15sp"
      android:textStyle="bold"
      android:maxLines="1" />
    <TextView
      android:id="@+id/widget_updated"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="#94A3B8"
      android:textSize="12sp"
      android:maxLines="1" />
  </LinearLayout>

  <TextView
    android:id="@+id/widget_coming"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:textColor="#4ADE80"
    android:textSize="14sp"
    android:textStyle="bold"
    android:maxLines="2"
    android:ellipsize="end"
    android:visibility="gone" />

  <TextView
    android:id="@+id/widget_people"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:textColor="#E2E8F0"
    android:textSize="14sp"
    android:maxLines="2"
    android:ellipsize="end"
    android:text="Open Stashr to load your home" />

  <TextView
    android:id="@+id/widget_weather"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:textColor="#94A3B8"
    android:textSize="13sp"
    android:maxLines="1"
    android:ellipsize="end"
    android:visibility="gone" />

  <TextView
    android:id="@+id/widget_tv"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:textColor="#94A3B8"
    android:textSize="13sp"
    android:maxLines="1"
    android:ellipsize="end"
    android:visibility="gone" />
</LinearLayout>
